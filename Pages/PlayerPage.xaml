<UserControl x:Class="Alero.Pages.PlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Alero">
    <Grid>
        <!-- Nada sonando -->
        <StackPanel x:Name="EmptyView" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource Card}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource Mist}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Nada se está reproduciendo" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Pon música o un video en cualquier aplicación y aparecerá aquí" Foreground="{StaticResource Mist}"
                       FontSize="11.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Lo que suena -->
        <Grid x:Name="MediaView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ArtBox" Width="108" Height="108" CornerRadius="20" Background="{StaticResource Card}" VerticalAlignment="Center">
                <TextBlock x:Name="ArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="32"
                           Foreground="{StaticResource Mist}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Foreground="{StaticResource Mist}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

                <a:Meter x:Name="SeekBar" Height="18" BarHeight="4" Margin="0,4,0,0" Cursor="Hand"
                         Fill="{StaticResource Ink}" Track="{StaticResource Track}"/>
                <Grid Margin="0,-2,0,0">
                    <TextBlock x:Name="ElapsedText" Foreground="{StaticResource Mist}" FontSize="10.5"/>
                    <TextBlock x:Name="RemainText" Foreground="{StaticResource Mist}" FontSize="10.5" HorizontalAlignment="Right"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}" Content="&#xE892;" FontSize="16" Width="44" Click="Prev_Click"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="20" Width="52" Click="Play_Click"/>
                    <Button x:Name="NextBtn" Style="{StaticResource IconBtn}" Content="&#xE893;" FontSize="16" Width="44" Click="Next_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
