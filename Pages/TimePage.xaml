<UserControl x:Class="Alero.Pages.TimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="156"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <!-- Interruptor: las dos herramientas en una sola opción -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ModeWatch" Style="{StaticResource PillBtn}" Content="Cronómetro" FontSize="11" Padding="11,4" Click="ModeWatch_Click"/>
                <Button x:Name="ModeTimer" Style="{StaticResource PillBtn}" Content="Temporizador" FontSize="11" Padding="11,4" Margin="6,0,0,0" Click="ModeTimer_Click"/>
            </StackPanel>
            <TextBlock x:Name="TimeText" FontSize="46" FontWeight="Light" FontFamily="{StaticResource Display}" Margin="-6,0,0,0"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartBtn" Style="{StaticResource AccentBtn}" Width="92" Padding="4,7" Click="Start_Click"/>
                <Button x:Name="LapBtn" Style="{StaticResource PillBtn}" Content="Vuelta" Width="64" Padding="4,7" Margin="6,0,0,0" Click="Lap_Click"/>
                <Button x:Name="ResetBtn" Style="{StaticResource PillBtn}" Content="Reiniciar" Width="72" Padding="4,7" Margin="6,0,0,0" Click="Reset_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Cronómetro: vueltas -->
        <Grid x:Name="LapsPanel" Grid.Column="1" Grid.ColumnSpan="2" Width="156" HorizontalAlignment="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="VUELTAS" Style="{StaticResource Label}" VerticalAlignment="Top"/>
            <ScrollViewer Grid.Row="1" Margin="0,2,0,-8" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <StackPanel x:Name="Laps"/>
            </ScrollViewer>
            <TextBlock x:Name="LapsEmpty" Grid.Row="1" Text="Pulsa Vuelta para marcar un tiempo" Foreground="{StaticResource Mist}"
                       FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Temporizador, en medio: los últimos tiempos iniciados + papelera para borrarlos -->
        <StackPanel x:Name="HistoryPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed">
            <TextBlock Text="HISTORIAL" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="HistoryList" Width="74"/>
                <Button x:Name="ClearBtn" Style="{StaticResource PillBtn}" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                        VerticalAlignment="Center" ToolTip="Borrar historial" Click="Clear_Click">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="14"/>
                </Button>
            </StackPanel>
            <TextBlock x:Name="HistoryEmpty" Text="Sin historial" Foreground="{StaticResource Mist}" FontSize="11.5"
                       Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Temporizador, a la derecha: horas, minutos y segundos -->
        <Grid x:Name="HmsPanel" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</UserControl>
