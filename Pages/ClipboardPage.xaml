<UserControl x:Class="Alero.Pages.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Interruptor Imágenes / Texto + vaciar -->
        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ModeImages" Style="{StaticResource PillBtn}" FontSize="11" Padding="11,4" Click="ModeImages_Click"/>
                <Button x:Name="ModeText" Style="{StaticResource PillBtn}" FontSize="11" Padding="11,4" Margin="6,0,0,0" Click="ModeText_Click"/>
            </StackPanel>
            <Button x:Name="ClearBtn" Style="{StaticResource PillBtn}" Content="Vaciar" FontSize="11" Padding="11,4"
                    Foreground="{StaticResource Mist}" HorizontalAlignment="Right" Click="Clear_Click"/>
        </Grid>

        <!-- Imágenes: tira que se recorre de lado (rueda del ratón o arrastrando) -->
        <ScrollViewer x:Name="ImgScroll" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="ImgList" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Texto: lista que se recorre hacia abajo -->
        <ScrollViewer x:Name="TextScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False" Margin="0,-2,0,-6" Visibility="Collapsed">
            <StackPanel x:Name="TextList"/>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Foreground="{StaticResource Mist}" FontSize="12" TextWrapping="Wrap"
                   TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"/>
    </Grid>
</UserControl>
